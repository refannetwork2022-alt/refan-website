{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "routes": [
    { "src": "/", "has": [{ "type": "query", "key": "voice" }], "dest": "/api/share" },
    { "src": "/", "has": [{ "type": "query", "key": "story" }], "dest": "/api/share" },
    { "src": "/", "has": [{ "type": "query", "key": "announcement" }], "dest": "/api/share" },
    { "src": "/", "has": [{ "type": "query", "key": "program" }], "dest": "/api/share" },
    { "src": "/share", "dest": "/api/share" },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
